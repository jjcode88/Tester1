# Copy to .env.local for local development. Every value is optional: with none
# set, the app runs fully on-device with sync and error tracking switched off.
# These are all PUBLIC values that ship in the browser bundle (see src/config.ts).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
VITE_ENVIRONMENT=development

# owner/name, so the Status page can show uptime history and CI runs
VITE_GITHUB_REPO=
